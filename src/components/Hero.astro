---
import { ArrowDown, ArrowUpRight, Coffee } from '@lucide/astro';
import { cafe } from '../data/cafe';
import StatusBadge from './StatusBadge.astro';
const navigation = [
  { href: '/reviews', label: 'Reviews' },
  { href: '/visit', label: 'Visit' },
];
---
<header class="hero-surface relative bg-forest text-foam">
  <nav aria-label="Main navigation" class="relative z-30 mx-auto flex max-w-6xl items-center justify-between gap-x-3 border-b border-foam/20 px-4 py-2 sm:px-8 lg:border-0 lg:py-5 lg:pr-72">
    <a href="/" class="inline-flex min-h-11 items-center gap-2.5 font-display text-lg font-bold lg:text-xl">
      {cafe.heroImage ? (
        <span class="grid size-12 place-items-center rounded-full bg-foam p-1.5 lg:hidden">
          <img src={cafe.heroImage} width="900" height="755" alt="" />
        </span>
      ) : <Coffee aria-hidden="true" class="size-5 text-butter lg:hidden" />}
      {cafe.name}
    </a>
    <div class="flex shrink-0 gap-1 text-sm font-semibold lg:gap-7">
      {navigation.map(({ href, label }) => (
        <a {href} data-section-link class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg px-1.5 hover:text-butter active:bg-foam/10 lg:min-w-0 lg:rounded-none lg:px-0">{label}</a>
      ))}
    </div>
  </nav>

  <div class="mx-auto grid max-w-6xl items-center gap-4 px-5 pt-5 sm:px-8 lg:grid-cols-[1.15fr_1fr] lg:gap-x-16 lg:gap-y-5 lg:pb-20 lg:pt-10">
    <div class="lg:self-end">
      <div class="lg:absolute lg:right-[max(2rem,calc((100%_-_72rem)/2_+_2rem))] lg:top-6"><StatusBadge /></div>
      <h1 class="mt-3 max-w-[16ch] font-display text-[clamp(2.35rem,10vw,4.25rem)] font-semibold leading-none tracking-tight lg:mt-0 lg:max-w-[10ch] lg:text-[clamp(4.4rem,6.3vw,6rem)] lg:leading-[1.02]">{cafe.motto}</h1>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-foam/85 lg:mt-5 lg:max-w-md lg:text-lg">{cafe.tagline}</p>
      <div class="mt-4 grid grid-cols-[1.25fr_1fr] gap-2.5 sm:max-w-sm lg:mt-6 lg:flex lg:max-w-none lg:flex-wrap lg:gap-3">
        <a href="/menu" data-section-link class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-butter px-3 py-3 font-bold text-bean hover:bg-foam lg:px-6 lg:py-3.5">
          View menu <ArrowDown aria-hidden="true" class="size-4 lg:hidden" />
        </a>
        <a href={cafe.mapsShortLink} class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-foam/50 px-3 py-3 font-bold hover:bg-foam/10 lg:px-6 lg:py-3.5">
          <span class="lg:hidden">Find us</span><span class="hidden lg:inline">Get directions</span> <ArrowUpRight aria-hidden="true" class="size-4 lg:hidden" />
        </a>
      </div>
    </div>

    {cafe.heroImage && (
      <div class="mx-auto hidden aspect-square w-full max-w-md place-items-center rounded-full bg-foam p-[2.75rem] shadow-lg shadow-bean/20 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:grid">
        <img src={cafe.heroImage} alt={`${cafe.name} logo`} width="900" height="755" fetchpriority="high"
          class="h-auto w-full" />
      </div>
    )}
    <ul class="flex flex-wrap gap-x-4 gap-y-1 border-t border-foam/20 py-3 text-xs font-medium text-foam/85 lg:self-start lg:gap-x-5 lg:pt-4 lg:text-sm">
      {cafe.amenities.map(({ label }) => <li>{label}</li>)}
    </ul>
  </div>
</header>

