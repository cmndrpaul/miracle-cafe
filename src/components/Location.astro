---
import { MapPin, Navigation, Clock } from '@lucide/astro';
import { cafe } from '../data/cafe';
const { lat, lng } = cafe;
const { streetAddress, addressLocality, addressRegion } = cafe.address;
const address = [streetAddress, addressLocality, addressRegion].join(', ');
const social = Object.entries(cafe.social).filter(([, url]) => url);
const mapUrl = `https://www.google.com/maps?q=${lat},${lng}&z=17&output=embed`;
---
<footer id="visit" class="bg-forest text-foam">
  <div class="mx-auto grid max-w-6xl gap-5 px-4 py-9 sm:px-8 md:grid-cols-2 md:py-12 lg:items-start lg:gap-x-14 lg:py-20">
    <div class="space-y-4 lg:col-start-2 lg:row-start-1 lg:flex lg:flex-col">
      <h2 class="font-display text-3xl font-bold sm:text-5xl">Visit the cafe</h2>
      <p class="flex gap-2"><MapPin class="mt-0.5 size-5 shrink-0 text-butter" />{address}</p>
      <p class="text-sm text-foam/75">Plus Code {cafe.plusCode}</p>
      <p class="flex gap-2"><Clock class="mt-0.5 size-5 shrink-0 text-butter" />{cafe.hoursLabel}</p>
      <p class="text-sm text-foam/75">{cafe.visitorInfo.join(' · ')}</p>
      <div class="border-t border-foam/20 pt-4 lg:order-2 lg:border-0 lg:pt-1">
        <h3 class="font-display text-xl font-bold lg:font-sans lg:text-sm lg:font-medium lg:text-foam/75">Other services</h3>
        <p class="mt-1 text-sm text-foam/85 lg:hidden">{cafe.services.join(' · ')}</p>
        <ul class="mt-2 hidden flex-wrap gap-2 text-sm text-foam/85 lg:flex">
          {cafe.services.map((service) => <li class="rounded-full bg-foam/10 px-3 py-1">{service}</li>)}
        </ul>
      </div>
      <div class="grid grid-cols-[1.3fr_1fr] gap-2.5 pt-1 lg:flex lg:flex-wrap lg:gap-3">
        <a href={cafe.mapsShortLink}
           class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-butter px-3 py-3 font-semibold text-bean active:scale-95 lg:px-5">
          <Navigation class="size-5" /> Google Maps
        </a>
        <a href={`https://waze.com/ul?ll=${lat},${lng}&navigate=yes`}
           class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-foam/40 px-3 py-3 font-semibold active:scale-95 lg:px-5">
          <Navigation class="size-5" /> Waze
        </a>
      </div>
      {social.length > 0 && (
        <div class="flex gap-3 pt-2">
          {social.map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener" aria-label={name}
               class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20">
              {name === 'facebook' ? (
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              ) : (
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>
              )}
            </a>
          ))}
        </div>
      )}
    </div>

    <iframe title={`Map of ${cafe.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      src={mapUrl} class="block aspect-[4/3] w-full rounded-2xl border-0 bg-sage lg:col-start-1 lg:row-start-1"></iframe>
  </div>
  <p class="border-t border-white/10 px-5 py-5 text-center text-sm text-foam/60">
    © {new Date().getFullYear()} {cafe.name}
  </p>
</footer>

