---
import type { MenuItem } from '../data/menu';
import { cafe } from '../data/cafe';
const { items } = Astro.props as { items: MenuItem[] };
const sections = [
  { id: 'drinks', name: 'Drinks', categories: ['Coffee', 'Non-Coffee', 'Matcha Series', 'Frappe', 'Smoothies', 'Fresh Juice', 'Fruit Teas', 'Other Beverages'] },
  { id: 'meals', name: 'Meals & snacks', categories: ['Rice Favorites', 'Classic Favorites', 'Rice Platter', 'Signature Pastas', 'Snacks', 'Sandwiches', 'Burgers'] },
  { id: 'sweets', name: 'Bakes & sweets', categories: ['Cookies', 'Cakes', 'Muffins', 'Dessert'] },
  { id: 'extras', name: 'Add-ons', categories: ['Add-ons'] },
];
const grouped = new Map<string, MenuItem[]>();
for (const item of items) {
  const categoryItems = grouped.get(item.category);
  if (categoryItems) categoryItems.push(item);
  else grouped.set(item.category, [item]);
}
const other = [...grouped.keys()].filter((category) => !sections.some((section) => section.categories.includes(category)));
if (other.length) sections.push({ id: 'other', name: 'Other', categories: other });
const categoryIds = new Map([...grouped.keys()].map((category, index) => [
  category, `menu-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${index + 1}`,
]));
const available = sections
  .map((section) => ({ ...section, categories: section.categories.filter((category) => grouped.has(category)) }))
  .filter((section) => section.categories.length);
const peso = (n: number) => `₱${n.toLocaleString('en-PH')}`;
const shortNames: Record<string, string> = { meals: 'Meals', sweets: 'Sweets' };
function sharedOptions(rows: MenuItem[]) {
  const labels = rows[0].options?.map(([label]) => label);
  return labels?.length && rows.every(({ options }) =>
    options?.length === labels.length && options.every(([label], i) => label === labels[i])
  ) ? labels : [];
}
---
<section id="menu" aria-labelledby="menu-heading" class="bg-foam pb-12 lg:bg-[color-mix(in_srgb,var(--color-sage)_40%,var(--color-foam))] lg:pb-14">
  <div class="px-5 pb-5 pt-9 sm:px-8 lg:sticky lg:top-0 lg:z-20 lg:bg-inherit lg:py-4">
    <div class="mx-auto max-w-[68rem] lg:flex lg:items-baseline lg:justify-between">
    <h2 id="menu-heading" class="font-display text-4xl font-bold tracking-tight text-forest sm:text-6xl">Menu</h2>
    <p class="mt-2 text-sm text-cocoa lg:mt-3 lg:text-base">{cafe.orderingNote}</p>
    </div>
  </div>
  <div class="lg:mx-auto lg:grid lg:max-w-6xl lg:grid-cols-[12rem_minmax(0,1fr)] lg:items-start lg:gap-6 lg:px-8">
  <nav aria-label="Menu sections" class="sticky top-0 z-10 border-y border-forest/15 bg-foam lg:top-24 lg:max-h-[calc(100dvh-6rem)] lg:overflow-y-auto lg:border-0 lg:bg-transparent">
    <ul class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-4 py-2 sm:px-8 lg:flex-col lg:overflow-visible lg:p-1">
      {available.map((section) => (
        <li class="shrink-0 max-lg:flex-1">
          <a data-menu-link href={`#${section.id}`} aria-label={section.name} class="peer inline-flex min-h-11 w-full items-center justify-center whitespace-nowrap rounded-lg bg-sage px-2.5 text-sm font-bold text-forest hover:bg-forest hover:text-foam aria-[current=true]:bg-forest aria-[current=true]:text-foam lg:justify-start lg:bg-transparent lg:px-3.5 lg:text-cocoa">
            {shortNames[section.id] ? <><span class="lg:hidden">{shortNames[section.id]}</span><span class="hidden lg:inline">{section.name}</span></> : section.name}
          </a>
          {section.categories.length > 1 && (
            <ul class="ml-3 hidden border-l border-forest/20 pl-2 lg:peer-aria-[current=true]:block">
              {section.categories.map((category) => (
                <li><a data-menu-category href={`#${categoryIds.get(category)}`} class="flex min-h-11 items-center rounded-md px-2 text-sm text-cocoa hover:bg-sage aria-[current=location]:bg-sage aria-[current=location]:font-bold aria-[current=location]:text-forest">{category}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 pt-4 sm:px-8 lg:px-0 lg:pt-0">
    {available.map((section) => (
    <section data-menu-panel id={section.id} class="scroll-mt-20">
        <h3 class="font-display text-2xl font-bold text-forest lg:sr-only">{section.name}</h3>
        <div class="mt-3 grid gap-3 lg:mt-0 lg:block lg:columns-2 lg:gap-6">
          {section.categories.map((category) => {
            const rows = grouped.get(category)!;
            const labels = sharedOptions(rows);
            return (
            <div id={categoryIds.get(category)} class="scroll-mt-20 overflow-hidden rounded-xl border border-forest/15 bg-white lg:mb-5 lg:break-inside-avoid lg:scroll-mt-24 lg:rounded-none lg:border-0 lg:bg-transparent lg:target:bg-sage/60">
              {category !== section.name && labels.length === 0 && <h4 class="border-b border-forest/15 bg-sage px-3 py-2 font-display text-xl font-bold text-forest sm:px-5 lg:border-forest lg:bg-transparent lg:px-0 lg:pb-2 lg:pt-0 lg:text-2xl">{category}</h4>}
              {labels.length > 0 ? (
                <table class="w-full border-collapse text-left">
                  <thead class="border-b border-forest/15 bg-sage lg:border-forest lg:bg-transparent">
                    <tr>
                      <th scope="col" class="py-2 pl-3 font-display text-xl font-bold text-forest lg:pt-0 lg:pl-0 lg:text-2xl">{category}</th>
                      {labels.map((label) => <th scope="col" class="py-2 pl-2 text-right text-xs font-semibold text-cocoa last:pr-3 lg:pt-0 lg:last:pr-0">{label.replace(' · ', ' ')}</th>)}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-forest/10">
                    {rows.map((item) => (
                      <tr>
                        <th scope="row" class="py-2 pr-1 pl-3 text-sm font-semibold lg:pl-0">
                          {item.name}
                          {item.soldOut && <span class="ml-2 text-xs text-cocoa">Sold out</span>}
                          {item.description && <span class="block text-xs font-normal text-cocoa">{item.description}</span>}
                        </th>
                        {item.options?.map(([, price]) => <td class="py-2 pl-2 text-right text-sm font-bold tabular-nums text-forest last:pr-3 lg:last:pr-0">{peso(price)}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
              <ul class="divide-y divide-forest/10 px-3 sm:px-5 lg:px-0">
                {rows.map((item) => (
                  <li class="py-2.5 lg:py-2">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="font-bold text-forest lg:text-sm lg:font-semibold lg:text-bean">{item.name}{item.soldOut && <span class="ml-2 text-xs font-semibold text-cocoa">Sold out</span>}</span>
                      {!item.options && item.price !== null && <span class="shrink-0 font-bold tabular-nums text-forest">{peso(item.price)}</span>}
                    </div>
                    {item.description && <p class="mt-1 text-sm text-cocoa">{item.description}</p>}
                    {item.options && (
                      <dl class="mt-2 flex flex-wrap gap-x-2 gap-y-1.5 text-xs sm:text-sm">
                        {item.options.map(([label, price]) => (
                          <div class="flex items-baseline gap-1.5 rounded-md bg-foam px-2 py-1 text-cocoa">
                            <dt>{label}</dt><dd class="font-bold tabular-nums text-forest">{peso(price)}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                  </li>
                ))}
              </ul>
              )}
            </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>
  </div>
</section>

<script>
  const menu = document.getElementById('menu');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]')];
  const categories = [...document.querySelectorAll<HTMLAnchorElement>('[data-menu-category]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-menu-panel]')];
  let active = links[0]?.hash;
  let selectedCategory = '';

  function syncMenu() {
    for (const link of links) {
      if (link.hash === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    for (const panel of panels) panel.hidden = `#${panel.id}` !== active;
    for (const category of categories) {
      if (category.hash === selectedCategory) category.setAttribute('aria-current', 'location');
      else category.removeAttribute('aria-current');
    }
  }

  function syncHash() {
    selectedCategory = location.hash;
    if (links.some((link) => link.hash === location.hash)) active = location.hash;
    else if (!location.hash) active = links[0]?.hash;
    else {
      const panel = document.getElementById(location.hash.slice(1))?.closest('[data-menu-panel]');
      if (panel) active = `#${panel.id}`;
    }
    syncMenu();
  }

  for (const link of [...links, ...categories]) {
    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const isCategory = link.hasAttribute('data-menu-category');
      const target = isCategory ? document.getElementById(link.hash.slice(1)) : menu;
      if (!target) return;
      event.preventDefault();
      if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
      if (isCategory) selectedCategory = link.hash;
      else {
        active = link.hash;
        selectedCategory = '';
      }
      syncMenu();
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start', behavior: 'instant' }));
    });
  }
  window.addEventListener('hashchange', syncHash);
  syncHash();
</script>
